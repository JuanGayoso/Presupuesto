# Copia este archivo a ".env" y completa los valores (o ejecuta ./setup.sh / setup.ps1, que lo hace por ti).
# El archivo .env NO se sube a git.

# Credenciales de la base de datos PostgreSQL (se crea sola dentro de Docker).
POSTGRES_USER=evaluacion
POSTGRES_DB=evaluacion_inmobiliaria
# Obligatoria. Usa solo letras, números, "_", "." o "-" (se inserta en una URL de conexión).
POSTGRES_PASSWORD=

# Puerto en el que se abre la aplicación: http://localhost:<APP_PORT>
APP_PORT=8000

# true = en el primer arranque crea una plantilla demo con datos de ejemplo.
SEED_ON_STARTUP=true
